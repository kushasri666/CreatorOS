MESH_API_KEY=
# Optional global text override; role-specific selections take precedence.
MESH_TEXT_MODEL=
MESH_BRAND_MODEL=openai/gpt-4.1-mini
MESH_STRATEGIST_MODEL=google/gemini-2.5-flash-lite
MESH_WRITER_MODEL=openai/gpt-4.1-mini
MESH_EDITOR_MODEL=openai/gpt-4.1-mini
MESH_VERIFIER_MODEL=openai/gpt-4.1-mini
MESH_FOLLOWUP_MODEL=openai/gpt-4.1-mini
MESH_VISUAL_MODEL=google/gemini-2.5-flash-lite
MESH_LEARNER_MODEL=google/gemini-2.5-flash-lite
MESH_IMAGE_MODEL=openai/gpt-image-1-mini
CREATOROS_DB=
CREATOROS_MODE=live
MESH_ENABLE_PAID=0
MESH_MAX_CALLS=10
MESH_MAX_OUTPUT_TOKENS=1600
MESH_FORMAT_RETRIES=0
# Personal LinkedIn read-only analytics: OAuth token granted r_member_postAnalytics.
# Keep this local; never paste tokens into chat or commit them.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202609
LINKEDIN_AUTO_SYNC=0

# All social integrations are read-only and paused until enabled in the UI.
# Register the callback URL: http://127.0.0.1:8000/connections/oauth/PROVIDER/callback
# Run scripts/setup_connections.py to initialize encryption (do not share its key).
CREATOROS_TOKEN_KEY=
CREATOROS_HTTPS=0
INSTAGRAM_CLIENT_ID=
# Opt-in before reauthorization to request publishing permission. No auto-posting.
INSTAGRAM_ENABLE_PUBLISHING=0
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/connections/oauth/instagram/callback
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/connections/oauth/youtube/callback
YOUTUBE_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/connections/oauth/linkedin/callback
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:8000/connections/oauth/threads/callback
THREADS_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/connections/oauth/x/callback
X_ACCESS_TOKEN=
SOCIAL_ENABLE_PAID_X=0
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram
MESH_CACHE_ENABLED=1
# Optional paid video / narration. OFF until explicitly configured and approved.
MESH_ENABLE_MEDIA_PAID=0
MESH_MEDIA_SPEND_CAP_CONFIGURED=0
MESH_VIDEO_MODEL=
MESH_SPEECH_MODEL=
MESH_SPEECH_VOICE=
